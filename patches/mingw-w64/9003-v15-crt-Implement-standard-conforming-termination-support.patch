diff --git a/mingw-w64-crt/crt/crtdll.c b/mingw-w64-crt/crt/crtdll.c
index 15ee52a7c..ef94f8237 100644
--- a/mingw-w64-crt/crt/crtdll.c
+++ b/mingw-w64-crt/crt/crtdll.c
@@ -16,6 +16,9 @@
 #endif
 #include <sect_attribs.h>
 #include <locale.h>
+#ifdef __USING_MCFGTHREAD__
+#include <mcfgthread/cxa.h>
+#endif
 
 extern void __cdecl __mingw_dll_do_global_ctors (void);
 extern void __cdecl __mingw_dll_do_global_dtors (void);
@@ -211,6 +214,16 @@ DllMainCRTStartup (HANDLE hDllHandle, DWORD dwReason, LPVOID lpreserved)
     {
 	retcode = _CRT_INIT (hDllHandle, dwReason, lpreserved);
     }
+#ifdef __USING_MCFGTHREAD__
+  if (dwReason == DLL_PROCESS_DETACH && lpreserved == NULL)
+    {
+      /* Call `__cxa_finalize(dso_handle)` if the library is unloaded
+       * dynamically. This conforms to the Itanium C++ ABI. Note it is
+       * not called in case of process termination, where a call to
+       * `__cxa_finalize(NULL)` shall have been made instead.  */
+      __MCF_cxa_finalize (&__dso_handle);
+    }
+#endif
 i__leave:
   __native_dllmain_reason = UINT_MAX;
   return retcode ;
diff --git a/mingw-w64-crt/crt/crtdll_atexit_register.c b/mingw-w64-crt/crt/crtdll_atexit_register.c
index 06c708316..c856dca63 100644
--- a/mingw-w64-crt/crt/crtdll_atexit_register.c
+++ b/mingw-w64-crt/crt/crtdll_atexit_register.c
@@ -6,14 +6,21 @@
 
 #include <stdlib.h>
 #include <corecrt_startup.h>
+#ifdef __USING_MCFGTHREAD__
+#include <mcfgthread/cxa.h>
+#endif
 
 static _onexit_table_t atexit_table;
 
 int __cdecl atexit(_PVFV func)
 {
+#ifdef __USING_MCFGTHREAD__
+  return __MCF_cxa_atexit(func, NULL, &__dso_handle);
+#else
   /* Do not use msvcrt's atexit() or UCRT's _crt_atexit() function as it
    * cannot be called from DLL library which may be unloaded at runtime. */
   return _register_onexit_function(&atexit_table, (_onexit_t)func);
+#endif
 }
 
 static int __cdecl __mingw_dll_atexit_table_func(int execute)
diff --git a/mingw-w64-crt/crt/crtexe.c b/mingw-w64-crt/crt/crtexe.c
index ca9b00691..a3a6f4680 100644
--- a/mingw-w64-crt/crt/crtexe.c
+++ b/mingw-w64-crt/crt/crtexe.c
@@ -16,6 +16,9 @@
 #include <locale.h>
 #include <float.h>
 #include <corecrt_startup.h>
+#ifdef __USING_MCFGTHREAD__
+#include <mcfgthread/cxa.h>
+#endif
 
 #if defined(__SEH__) && (!defined(__clang__) || __clang_major__ >= 7)
 #define SEH_INLINE_ASM
@@ -335,12 +338,16 @@ static int duplicate_ppstrings (int ac, _TCHAR ***av)
 
 int __cdecl atexit (_PVFV func)
 {
+#ifdef __USING_MCFGTHREAD__
+    return __MCF_cxa_atexit(func, NULL, &__dso_handle);
+#else
     /*
      * msvcrt def file renames the real atexit() function to _crt_atexit().
      * UCRT provides atexit() function only under name _crt_atexit().
      * So redirect call to _crt_atexit() function.
      */
     return _crt_atexit(func);
+#endif
 }
 
 const char __mingw_module_is_dll = 0;
diff --git a/mingw-w64-crt/crt/tls_atexit.c b/mingw-w64-crt/crt/tls_atexit.c
index bb0390fa0..9208faa02 100644
--- a/mingw-w64-crt/crt/tls_atexit.c
+++ b/mingw-w64-crt/crt/tls_atexit.c
@@ -16,12 +16,27 @@
 #include <stdlib.h>
 #include <corecrt_startup.h>
 #include <process.h>
+#ifdef __USING_MCFGTHREAD__
+#include <mcfgthread/cxa.h>
+#endif
 
 
 typedef void (__thiscall * dtor_fn)(void*);
 int __mingw_cxa_atexit(dtor_fn dtor, void *obj, void *dso);
 int __mingw_cxa_thread_atexit(dtor_fn dtor, void *obj, void *dso);
 
+#ifdef __USING_MCFGTHREAD__
+
+int __mingw_cxa_atexit(dtor_fn dtor, void *obj, void *dso) {
+  return __MCF_cxa_atexit(dtor, obj, dso);
+}
+
+int __mingw_cxa_thread_atexit(dtor_fn dtor, void *obj, void *dso) {
+  return __MCF_cxa_thread_atexit(dtor, obj, dso);
+}
+
+#else  /* __USING_MCFGTHREAD__  */
+
 typedef struct dtor_obj dtor_obj;
 struct dtor_obj {
   dtor_fn dtor;
@@ -208,3 +223,5 @@ WINBOOL (WINAPI *const __mingw_cxa_tls_callback_ptr)(HANDLE,DWORD,LPVOID) = tls_
 /* Force inclusion of code which calls __mingw_cxa_tls_callback_ptr */
 extern const int __mingw_cxa_tls_callback_caller_provider;
 static __attribute__((used)) const void *const _include_mingw_cxa_tls_callback_caller = &__mingw_cxa_tls_callback_caller_provider;
+
+#endif  /* __USING_MCFGTHREAD__  */
